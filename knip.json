{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/index.ts",
    "src/cli/cli.ts",
    "src/runtime/playwright.config.ts",
    "src/runner/runner.*",
    "scripts/*.mjs",
    "tests/**/*.spec.ts",
    "typecheck/*.ts",
    "src/cli/flow-tests/*.spec.ts",
    "docs/.vitepress/config.mts",
    "docs/.vitepress/theme/index.ts"
  ],
  "project": [
    "src/**/*.{ts,js}",
    "scripts/**",
    "tests/**/*.ts",
    "typecheck/**/*.ts",
    "docs/.vitepress/theme/*.ts"
  ],
  "ignore": [
    "tests/fixtures/**",
    "scripts/build-ui-css.d.mts"
  ],
  "ignoreDependencies": [
    "tailwindcss",
    "@tailwindcss/cli",
    "@phosphor-icons/core"
  ],
  "ignoreBinaries": [
    "diff"
  ],
  "ignoreExportsUsedInFile": true,
  "rules": {
    "duplicates": "off"
  }
}
