{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/index.ts",
    "src/beta.ts",
    "src/cli/cli.ts",
    "src/runtime/playwright.config.ts",
    "src/runner/runner.*",
    "scripts/*.mjs",
    "tests/**/*.spec.ts",
    "typecheck/*.ts"
  ],
  "project": [
    "src/**/*.{ts,js}",
    "scripts/**",
    "tests/**/*.ts",
    "typecheck/**/*.ts"
  ],
  "ignore": [
    "tests/fixtures/**"
  ],
  "ignoreDependencies": [
    "open-props"
  ],
  "ignoreBinaries": [
    "diff"
  ],
  "ignoreExportsUsedInFile": true,
  "rules": {
    "duplicates": "off"
  }
}
