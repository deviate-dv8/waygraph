#!/usr/bin/env node
/**
 * Cross-platform CLI launcher.
 *
 * Why Node (not #!/bin/sh + readlink -f):
 *   - macOS BSD `readlink` has no `-f` (GNU) -> "illegal option -- f" / broken bin
 *   - Windows npm expects a Node shebang for `.cmd` shims
 *
 * Still registers `tsx/esm` before `dist/cli/cli.js` so consumer `.block.ts` /
 * `.flow.ts` dynamic imports resolve the same as the old shell wrapper.
 */
import { spawn } from "node:child_process";
import { createRequire } from "node:module";
import { dirname, join } from "node:path";
import { fileURLToPath } from "node:url";

const pkgRoot = join(dirname(fileURLToPath(import.meta.url)), "..");
const require = createRequire(join(pkgRoot, "package.json"));
let tsxEsm;
try {
  tsxEsm = require.resolve("tsx/esm");
} catch (err) {
  console.error(
    "waygraph: cannot resolve dependency \"tsx\" (required to load .ts Blocks).\n" +
      "  Reinstall: npm install waygraph\n" +
      `  Detail: ${err instanceof Error ? err.message : String(err)}`,
  );
  process.exit(1);
}

const cli = join(pkgRoot, "dist", "cli", "cli.js");
const child = spawn(
  process.execPath,
  ["--import", tsxEsm, cli, ...process.argv.slice(2)],
  { stdio: "inherit", env: process.env, windowsHide: true },
);

child.on("error", (err) => {
  console.error(`waygraph: failed to start CLI: ${err.message}`);
  process.exit(1);
});
// A stop sent to this launcher alone (a process manager, CI, `kill <pid>`) reaches the CLI, so what it started (a
// server, a browser) stops with it. Ctrl-C reaches the CLI from the terminal already: wait for it to finish instead.
for (const signal of ["SIGTERM", "SIGHUP"]) process.on(signal, () => child.kill(signal));
process.on("SIGINT", () => {});
child.on("exit", (code, signal) => {
  if (signal) {
    process.kill(process.pid, signal);
    return;
  }
  process.exit(code ?? 1);
});
