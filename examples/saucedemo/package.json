{
  "name": "waygraph-example-saucedemo",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Full Sauce Demo (saucedemo.com) example - Effect / MemNav / waygraph auto.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "flows": "waygraph list .",
    "demo": "waygraph demo shopFlow .",
    "demo:step": "waygraph demo shopFlow . --step --no-autoplay --title \"Shop demo\"",
    "demo:autoplay": "waygraph demo shopFlow . --autoplay --title \"Shop demo\"",
    "auto": "waygraph auto .",
    "auto:cli": "waygraph auto . --cli",
    "graph": "waygraph graph .",
    "graph:mermaid": "waygraph graph . --mermaid",
    "prove:login-branch": "node scripts/prove-wrong-login-runtime.mjs",
    "prove:graph": "node scripts/prove-auto-graph.mjs",
    "prove:add-to-cart-menu": "node scripts/prove-add-to-cart-menu.mjs",
    "prove": "npm run prove:login-branch && npm run prove:graph && npm run prove:add-to-cart-menu && npm test",
    "record": "waygraph chain \"loginFlow({\\\"saucedemo.credentials\\\":{\\\"username\\\":\\\"standard_user\\\",\\\"password\\\":\\\"secret_sauce\\\"}}) then shopFlow({\\\"saucedemo.selectedItem\\\":{\\\"id\\\":\\\"sauce-labs-backpack\\\",\\\"name\\\":\\\"Sauce Labs Backpack\\\"}})\" . --video --no-step"
  },
  "waygraph": {
    "baseUrl": "https://www.saucedemo.com"
  },
  "dependencies": {
    "waygraph": "file:../.."
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^26.0.0",
    "typescript": "^5.6.0"
  }
}
