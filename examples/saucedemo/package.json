{
  "name": "waygraph-example-saucedemo",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Full Sauce Demo (saucedemo.com) example - Effect / MemNav / waygraph auto.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "waygraph test",
    "test:ui": "waygraph test ui",
    "flows": "waygraph list",
    "check": "waygraph check",
    "graph": "waygraph graph",
    "graph:mermaid": "waygraph graph --mermaid",
    "auto": "waygraph auto",
    "auto:cli": "waygraph auto --cli",
    "demo": "waygraph demo --blocks \"loginFlow then shopFlow\"",
    "demo:auto-next": "waygraph demo --blocks \"loginFlow then shopFlow\" --auto-next",
    "demo:checkout": "waygraph demo --blocks checkoutFlow --auto-next",
    "demo:device": "waygraph demo --blocks deviceShowcaseFlow --auto-next",
    "demo:bulk": "waygraph demo --blocks cartBulkFlow --auto-next",
    "demo:api": "waygraph demo --blocks apiDemoFlow --auto-next",
    "demo:video": "waygraph demo --blocks deviceShowcaseFlow --auto-play-video",
    "record": "waygraph run --blocks \"loginFlow then shopFlow\" --video --no-step",
    "traverse": "waygraph traverse --max-steps 40"
  },
  "dependencies": {
    "waygraph": "file:../.."
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "typescript": "^5.6.0"
  }
}
