{
  "name": "waygraph-quickstart",
  "private": true,
  "type": "module",
  "description": "Self-contained saucedemo quickstart - 2-episode chainFlow demo (Sign In + blocked Viewer login).",
  "scripts": {
    "test": "playwright test",
    "demo": "waygraph chain \"loginFlow({\\\"username\\\":\\\"standard_user\\\",\\\"password\\\":\\\"secret_sauce\\\"}) then viewerBlockedFlow({\\\"username\\\":\\\"locked_out_user\\\",\\\"password\\\":\\\"secret_sauce\\\"})\" . --step --no-autoplay",
    "record": "waygraph chain \"loginFlow({\\\"username\\\":\\\"standard_user\\\",\\\"password\\\":\\\"secret_sauce\\\"}) then viewerBlockedFlow({\\\"username\\\":\\\"locked_out_user\\\",\\\"password\\\":\\\"secret_sauce\\\"})\" . --video --no-step"
  },
  "waygraph": {
    "baseUrl": "https://www.saucedemo.com"
  },
  "dependencies": {
    "waygraph": "^0.7.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^26.0.0",
    "typescript": "^5.6.0"
  }
}
