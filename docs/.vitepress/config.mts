import { readFileSync, existsSync } from "node:fs";
import { defineConfig } from "vitepress";
import { withMermaid } from "vitepress-plugin-mermaid";

// Generated by `npm run docs:api` (TypeDoc) from the source's TSDoc.
const apiSidebar = existsSync("docs/api/typedoc-sidebar.json")
  ? JSON.parse(readFileSync("docs/api/typedoc-sidebar.json", "utf8"))
  : [];

// The footer reads the release it documents, so it can't go stale.
const pkg = JSON.parse(readFileSync("package.json", "utf8")) as {
  version: string;
  license: string;
  engines: { node: string };
  peerDependencies: Record<string, string>;
};
const node = pkg.engines.node.replace(/^>=\s*/, "");

