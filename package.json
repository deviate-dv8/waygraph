{
  "name": "waygraph",
  "version": "0.15.31",
  "type": "module",
  "description": "A typed graph of reusable Blocks for driving a browser through E2E flows.",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./runner": {
      "default": "./dist/runner/index.js"
    }
  },
  "bin": {
    "waygraph": "bin/waygraph"
  },
  "files": [
    "dist",
    "bin",
    "templates",
    "examples",
    "assets",
    "!examples/**/.tmp",
    "!examples/**/.tmp/**",
    "!examples/**/.waygraph-traverse",
    "!examples/**/.waygraph-traverse/**",
    "!examples/**/.waygraph-videos",
    "!examples/**/.waygraph-videos/**",
    "!**/*.webm"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deviate-dv8/waygraph.git"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-runner.mjs",
    "typecheck": "node bin/waygraph typecheck .",
    "test": "npm run check:structure && npm run test:unit && playwright test",
    "test:ui": "playwright test --ui",
    "test:unit": "node --import tsx/esm --test tests/unit/*.spec.ts",
    "docs:preview": "python3 -m http.server 4173 --directory docs",
    "example:saucedemo:install": "npm --prefix examples/saucedemo install",
    "example:saucedemo:test": "npm --prefix examples/saucedemo test",
    "example:saucedemo:auto": "npm --prefix examples/saucedemo run auto",
    "check:structure": "node scripts/check-structure.mjs"
  },
  "peerDependencies": {
    "@playwright/test": "^1.40.0"
  },
  "dependencies": {
    "tsx": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.0.0",
    "typescript": "^5.6.0"
  }
}
