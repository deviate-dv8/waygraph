{
  "name": "waygraph",
  "version": "0.16.6",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "description": "A typed graph of reusable Blocks for driving a browser through E2E flows.",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./beta": {
      "types": "./dist/beta.d.ts",
      "default": "./dist/beta.js"
    },
    "./runner": {
      "default": "./dist/runner/runner.js"
    }
  },
  "bin": {
    "waygraph": "bin/waygraph"
  },
  "files": [
    "dist",
    "bin",
    "templates",
    "examples",
    "assets",
    "!examples/**/.tmp",
    "!examples/**/.tmp/**",
    "!examples/**/.waygraph-traverse",
    "!examples/**/.waygraph-traverse/**",
    "!examples/**/.waygraph-videos",
    "!examples/**/.waygraph-videos/**",
    "!**/*.webm",
    "!**/.waygraph-auto",
    "!**/.waygraph-auto/**",
    "!**/test-results",
    "!**/test-results/**",
    "!**/playwright-report",
    "!**/playwright-report/**",
    "!**/.waygraph-chain-*.mjs",
    "!**/*.log",
    "!examples/**/.waygraph",
    "!examples/**/.waygraph/**"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deviate-dv8/waygraph.git"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.build.json && node scripts/build-ui-css.mjs",
    "typecheck": "node bin/waygraph typecheck .",
    "test": "npm run check:structure && npm run knip && npm run test:unit && playwright test",
    "test:ui": "playwright test --ui",
    "test:unit": "node --import tsx/esm --test tests/unit/*.spec.ts",
    "example:saucedemo:install": "npm --prefix examples/saucedemo install",
    "examples:link": "node scripts/link-examples.mjs",
    "example:saucedemo:test": "npm --prefix examples/saucedemo test",
    "example:saucedemo:auto": "npm --prefix examples/saucedemo run auto",
    "check:structure": "node scripts/check-structure.mjs",
    "docs:dev": "npm run docs:api && vitepress dev docs",
    "docs:build": "npm run docs:api && vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "docs:api": "typedoc && node scripts/gen-deprecated.mjs && node --import tsx scripts/gen-env.mjs",
    "knip": "knip",
    "sync:quickstart": "node scripts/sync-quickstart.mjs",
    "icons": "node scripts/gen-icons.mjs",
    "storybook": "storybook dev -p 6006 --no-open",
    "storybook:build": "storybook build -o storybook-static"
  },
  "peerDependencies": {
    "@playwright/test": "^1.40.0"
  },
  "dependencies": {
    "ts-morph": "^28.0.0",
    "tsx": "^4.0.0",
    "urlpattern-polyfill": "^10.1.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@phosphor-icons/core": "^2.1.1",
    "@playwright/test": "^1.63.0",
    "@storybook/html-vite": "^10.6.5",
    "@tailwindcss/cli": "^4.3.3",
    "@types/node": "^26.0.0",
    "knip": "^6.42.1",
    "storybook": "^10.6.5",
    "tailwindcss": "^4.3.3",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.14.1",
    "typedoc-vitepress-theme": "^1.1.4",
    "typescript": "^5.6.0",
    "vite": "^5.4.21",
    "vitepress": "^1.6.4"
  }
}
